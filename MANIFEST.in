include LICENSE README.md CONTRIBUTING.md PRODUCT.md DESIGN.md
recursive-include docs *.md
recursive-include examples *.yaml
recursive-include frontend/src *.ts *.tsx *.css
include frontend/package.json frontend/package-lock.json frontend/vite.config.js frontend/index.html
include .impeccable/design.json
recursive-include src/release_workbench/static *
include src/release_workbench/NOTICE.txt
include src/release_workbench/schema.json

recursive-include .impeccable/surfaces *.md

include frontend/tsconfig.json frontend/vitest.config.ts frontend/playwright.config.ts
recursive-include frontend/scripts *.mjs
recursive-include frontend/e2e *.ts *.py
recursive-include tests *.py

include src/release_workbench/THIRD_PARTY_NOTICES.txt

recursive-include docs *.png *.yaml *.py
recursive-include docs-site *.json *.mjs *.py *.mts *.ts *.css *.md
prune docs-site/node_modules
prune docs-site/.vitepress/cache
prune docs-site/.vitepress/dist
recursive-include src/release_workbench/documentation *

include src/release_workbench/THIRD_PARTY_DOCUMENTATION_NOTICES.txt

global-exclude *.py[cod]

recursive-include npm/workbench *.json *.md *.cjs
prune npm/workbench/runtime
